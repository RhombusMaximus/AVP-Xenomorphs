<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>RRYautja</RootNamespace>
    <AssemblyName>RRYautja</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
      <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Xenomorph\Hives\Class1.cs" />
    <Compile Remove="Xenomorph\Hives\HiveGrid.cs" />
    <Compile Remove="Xenomorph\Jobstuff\Drivers\TunnelHiveLikeSpawner.cs" />
    <Compile Remove="Xenomorph\XenoGetPawnThing.cs" />
  </ItemGroup>



  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.5014-unstable" />
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.7" />
  </ItemGroup>

</Project>