<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <RaidStrategyDef>
    <defName>RRY_PowerCut</defName>
    <workerClass>RaidStrategyWorker_ImmediateAttackSmart_CutPower</workerClass>
    <selectionWeightPerPointsCurve>
      <points>
        <li>(1000,0)</li>
        <li>(10000,1)</li>
      </points>
    </selectionWeightPerPointsCurve>
    <pointsFactorCurve>
      <points>
        <li>0, 0.0</li>
        <li>3000, 0.30</li>
      </points>
    </pointsFactorCurve>
    <arriveModes>
      <!-- RRY_RandomDropThroughRoof removed (USCM dropship) -->
    </arriveModes>
    <letterLabelEnemy>Raid</letterLabelEnemy>
    <arrivalTextEnemy>They are attacking immediately.</arrivalTextEnemy>
  </RaidStrategyDef>

  <!--
    Custom immediate-attack strategy for Xenomorph raids.
    Uses RaidStrategyWorker_XenomorphImmediateAttack which creates a
    LordJob_XenomorphAssaultColony with the kidnap-first RRY_Xenomorph_AssaultColony
    duty (no building trash), instead of vanilla LordJob_AssaultColony.
  -->
  <RaidStrategyDef>
    <defName>RRY_XenomorphImmediateAttack</defName>
    <workerClass>RaidStrategyWorker_XenomorphImmediateAttack</workerClass>
    <selectionWeightPerPointsCurve>
      <points>
        <li>(0,1)</li>
      </points>
    </selectionWeightPerPointsCurve>
    <letterLabelEnemy>Raid</letterLabelEnemy>
    <arrivalTextEnemy>They are attacking immediately.</arrivalTextEnemy>
  </RaidStrategyDef>
</Defs>
