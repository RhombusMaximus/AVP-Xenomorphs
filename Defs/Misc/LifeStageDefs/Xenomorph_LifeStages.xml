<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <LifeStageDef>
    <defName>RRY_XFacehuggerFullyFormed</defName>
    <label>fully-formed</label>
    <visible>false</visible>
    <developmentalStage>Adult</developmentalStage>
  </LifeStageDef>

  <!-- Newborn chestburster: ravenous, needs food immediately -->
  <LifeStageDef>
    <defName>RRY_XenomorphChestBursterBaby</defName>
    <label>newborn</label>
    <!-- 1.6: developmentalStage gates PawnGenerator age generation.
         Without this, age-gen can't produce a valid age (300 retries error). -->
    <developmentalStage>Newborn</developmentalStage>
    <bodySizeFactor>0.2</bodySizeFactor>
		<foodMaxFactor>1.5</foodMaxFactor>
		<healthScaleFactor>1</healthScaleFactor>
    <hungerRateFactor>5.0</hungerRateFactor>
    <marketValueFactor>0.5</marketValueFactor>
    <meleeDamageFactor>0.5</meleeDamageFactor>
    <statFactors>
      <MoveSpeed>2</MoveSpeed>
    </statFactors>
  </LifeStageDef>

  <!-- Shedling: still very hungry, growing fast -->
  <LifeStageDef>
    <defName>RRY_XenomorphChestBursterBig</defName>
    <label>shedling</label>
    <developmentalStage>Newborn</developmentalStage>
    <bodySizeFactor>0.32</bodySizeFactor>
		<foodMaxFactor>1.5</foodMaxFactor>
		<healthScaleFactor>1</healthScaleFactor>
    <hungerRateFactor>3.0</hungerRateFactor>
    <marketValueFactor>0.7</marketValueFactor>
    <meleeDamageFactor>0.6</meleeDamageFactor>
    <statFactors>
      <MoveSpeed>2</MoveSpeed>
    </statFactors>
  </LifeStageDef>

  <!-- Young: hungry but slowing down -->
  <LifeStageDef>
    <defName>RRY_XenomorphFormedBaby</defName>
    <label>young</label>
    <developmentalStage>Newborn</developmentalStage>
    <bodySizeFactor>0.5</bodySizeFactor>
    <healthScaleFactor>1</healthScaleFactor>
    <hungerRateFactor>2.0</hungerRateFactor>
    <marketValueFactor>0.9</marketValueFactor>
    <meleeDamageFactor>0.7</meleeDamageFactor>
    <statFactors>
      <MoveSpeed>0.65</MoveSpeed>
    </statFactors>
  </LifeStageDef>

  <!-- Adolescent: slowing down -->
  <LifeStageDef>
    <defName>RRY_XenomorphFormedMid</defName>
    <label>adolecant</label>
    <adjective>teenage</adjective>
    <reproductive>true</reproductive>
    <developmentalStage>Adult</developmentalStage>
    <bodySizeFactor>0.85</bodySizeFactor>
    <healthScaleFactor>1</healthScaleFactor>
    <hungerRateFactor>0.5</hungerRateFactor>
    <meleeDamageFactor>0.75</meleeDamageFactor>
    <statFactors>
      <MoveSpeed>0.95</MoveSpeed>
    </statFactors>
  </LifeStageDef>
  
  <!-- Adult: extremely slow metabolism, months before starving -->
  <LifeStageDef>
    <defName>RRY_XenomorphFullyFormed</defName>
    <label>adult</label>
    <visible>false</visible>
    <reproductive>true</reproductive>
    <milkable>true</milkable>
    <developmentalStage>Adult</developmentalStage>
    <hungerRateFactor>0.1</hungerRateFactor>
  </LifeStageDef>

  <!-- Praetorian: royal guard, spawns fully grown, very slow metabolism -->
  <LifeStageDef>
    <defName>RRY_XenomorphPraetorian</defName>
    <label>Praetorian</label>
    <visible>false</visible>
    <developmentalStage>Adult</developmentalStage>
    <bodySizeFactor>1.0</bodySizeFactor>
    <hungerRateFactor>0.1</hungerRateFactor>
  </LifeStageDef>

</Defs>