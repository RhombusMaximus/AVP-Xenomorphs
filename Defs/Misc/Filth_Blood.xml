<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Active acidic blood: inherits vanilla Filth_Blood graphics (real vanilla
       splatter art + Graphic_Random variation) but uses our acid-damage
       thingClass so it hurts pawns/things that touch it. -->
  <ThingDef Class="RRYautja.Filth_AddAcidDamageDef" ParentName="Filth_Blood">
    <defName>RRY_FilthBloodXenomorph_Active</defName>
    <label>acidic blood</label>
    <tickerType>Normal</tickerType>
    <thingClass>RRYautja.Filth_AddAcidDamage</thingClass>
  </ThingDef>

  <!-- Regular blood defs kept for save compatibility / DefOf references.
       Now inherit vanilla blood graphics too. -->
  <ThingDef ParentName="Filth_Blood">
    <defName>RRY_FilthBloodXenomorph</defName>
    <label>blood</label>
  </ThingDef>

  <ThingDef ParentName="Filth_Blood">
    <defName>RRY_FilthBloodNeomorph</defName>
    <label>blood</label>
  </ThingDef>

</Defs>