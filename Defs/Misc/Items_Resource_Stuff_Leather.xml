    <graphicData>
      <color>(878,878,878)</color>
    </graphicData>
    <statBases>
      <MarketValue>3.5</MarketValue>
      <StuffPower_Armor_Sharp>0.90</StuffPower_Armor_Sharp>
      <StuffPower_Insulation_Cold>2</StuffPower_Insulation_Cold>
